 journal = {TAXON},
 keywords = {incomplete lineage sorting, incongruence, introgression, phylogeny, systematics},
 language = {en},
 note = {_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/tax.70124},
 number = {2},
 pages = {e70124},
 shorttitle = {Phylogenomic use of low-copy nuclear markers from genome skimming data},
 title = {Phylogenomic use of low-copy nuclear markers from genome skimming data: An example from Melastomataceae},
